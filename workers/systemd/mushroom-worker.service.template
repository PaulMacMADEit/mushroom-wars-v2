[Unit]
Description=Mushroom Wars v2 training worker
After=network-online.target
Wants=network-online.target
# Limit restart thrash: if the unit restarts >5 times in 5 min, stop trying.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory={{REPO}}
# `-u` forces unbuffered stdout/stderr so log tails stream in real time.
ExecStart={{VENV_PYTHON}} -u {{REPO}}/workers/worker.py
Restart=always
RestartSec=15
StandardOutput=append:{{LOG_DIR}}/worker.out.log
StandardError=append:{{LOG_DIR}}/worker.err.log
Environment=PYTHONUNBUFFERED=1
# Cap JAX device memory so PyTorch + JAX share the RTX 3070's 8 GiB
# without OOM (JAX_PORT_PLAN §3.6). Worker.py also defaults this via
# os.environ.setdefault, but setting it here makes the cap explicit.
Environment=XLA_PYTHON_CLIENT_MEM_FRACTION=0.40

[Install]
WantedBy=default.target
