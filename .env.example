# Mushroom Wars v2 — environment template
# Copy to .env (git-ignored) and fill in secrets from Supabase dashboard:
#   https://supabase.com/dashboard/project/zbqujavkizijhiveqoxv/settings/api

# ── Project identity ───────────────────────────────────────────
SUPABASE_PROJECT_ID=zbqujavkizijhiveqoxv
SUPABASE_URL=https://zbqujavkizijhiveqoxv.supabase.co

# ── API keys (get from Supabase dashboard → Settings → API) ────
# Safe to expose in the browser. Use this one in the dashboard webapp.
SUPABASE_ANON_KEY=PASTE_ANON_KEY_HERE

# SECRET. Never commit. Never ship to the browser.
# Workers, CLIs, and migration scripts use this to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE

# ── Postgres connection strings ────────────────────────────────
# cli/db.py prefers SUPABASE_POOL_URL when set. The direct connection is
# IPv6-only on current Supabase and isn't routable from some networks;
# the pooler (port 6543) is IPv4-available and recommended for app code.
# Grab both from: Supabase dashboard → Database → Connection string.
SUPABASE_DB_PASSWORD=PASTE_DB_PASSWORD_HERE
SUPABASE_POOL_URL=postgresql://postgres.zbqujavkizijhiveqoxv:PASTE_DB_PASSWORD_HERE@aws-1-us-east-1.pooler.supabase.com:6543/postgres
# Direct connection — used by migrations/psql only:
SUPABASE_DB_URL=postgresql://postgres:PASTE_DB_PASSWORD_HERE@db.zbqujavkizijhiveqoxv.supabase.co:5432/postgres
# ── Worker tuning (optional) ───────────────────────────────────
# Override hostname reported to runs.machine. Default = os.hostname().
# WORKER_MACHINE_TAG=mac-home

# Device selection for PyTorch. Default = auto (cuda > mps > cpu).
# TORCH_DEVICE=cuda

# ── Modal (only needed on Modal workers) ───────────────────────
# Set via: modal secret create supabase SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=...
