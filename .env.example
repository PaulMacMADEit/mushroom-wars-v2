# Mushroom Wars v2 — environment template
# Copy to .env (git-ignored) and fill in secrets from Supabase dashboard:
#   https://supabase.com/dashboard/project/lwkljcyspyqklyoagnmo/settings/api

# ── Project identity ───────────────────────────────────────────
SUPABASE_PROJECT_ID=lwkljcyspyqklyoagnmo
SUPABASE_URL=https://lwkljcyspyqklyoagnmo.supabase.co

# ── API keys (get from Supabase dashboard → Settings → API) ────
# Safe to expose in the browser. Use this one in the dashboard webapp.
SUPABASE_ANON_KEY=PASTE_ANON_KEY_HERE

# SECRET. Never commit. Never ship to the browser.
# Workers, CLIs, and migration scripts use this to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE

# ── Direct Postgres connection (for schema migrations / psql) ──
SUPABASE_DB_PASSWORD=moeoper1mop
# Direct connection (for DDL, schema migrations, psql, pgtyped):
SUPABASE_DB_URL=postgresql://postgres:moeoper1mop@db.lwkljcyspyqklyoagnmo.supabase.co:5432/postgres
# Pooler connection (for app code — lower latency, connection reuse):
# You'll find the right region in the Supabase dashboard → Settings → Database → Connection pooling
# SUPABASE_POOL_URL=postgresql://postgres.lwkljcyspyqklyoagnmo:moeoper1mop@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Worker tuning (optional) ───────────────────────────────────
# Override hostname reported to runs.machine. Default = os.hostname().
# WORKER_MACHINE_TAG=mac-home

# Device selection for PyTorch. Default = auto (cuda > mps > cpu).
# TORCH_DEVICE=cuda

# ── Modal (only needed on Modal workers) ───────────────────────
# Set via: modal secret create supabase SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=...
